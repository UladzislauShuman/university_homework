{
 "uid": "lab2",
 "title": "lab2 — кэширование",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Пропускная способность сервиса (запросов/с)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "interval": "1s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/users/{id}\",status=\"200\"}[5s]))",
     "legendFormat": "успешные (200)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/users/{id}\",status!=\"200\"}[5s]))",
     "legendFormat": "ошибки",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Задержка ответа сервиса (перцентили)",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "interval": "1s",
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/users/{id}\"}[5s])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/users/{id}\"}[5s])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/users/{id}\"}[5s])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Кэш: попадания / промахи / ошибки redis (в секунду)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "interval": "1s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(users_cache_total[5s]))",
     "legendFormat": "{{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Доля попаданий в кэш (hit ratio)",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "interval": "1s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(users_cache_total{result=\"hit\"}[5s])) / sum(rate(users_cache_total[5s]))",
     "legendFormat": "hit ratio",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU контейнеров (1.0 = одно ядро; лимит postgres = 1.0, redis = 0.5)",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
