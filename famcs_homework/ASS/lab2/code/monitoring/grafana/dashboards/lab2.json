    {
     "refId": "B",
     "expr": "sum(rate(users_db_query_seconds_count[5s]))",
     "legendFormat": "запросов в базу от сервиса/с",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Пул соединений к базе (Hikari, 10 соединений)",
